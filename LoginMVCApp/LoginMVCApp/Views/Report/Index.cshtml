@model LoginMVCApp.ViewModels.DashboardViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Production Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Arial Black", Arial, sans-serif;
            background: #222;
            padding: 0;
            margin: 0;
        }

        .dashboard-container {
            max-width: 100vw;
            margin: 0;
            background: #000;
            border: 4px solid #1d786a;
            border-top: 20px solid #1d786a;
            border-radius: 0;
            overflow: hidden;
            box-shadow: none;
            padding-top: 6px;
        }

        /* Header Section */
        .header-section {
            background: #222;
            padding: 0;
            border-bottom: 4px solid #00ff00;
        }

        .date-time {
            color: #ffff00;
            font-weight: bold;
            font-size: 18px;
            padding: 6px 0;
            letter-spacing: 1px;
        }

        /* Main Grid */
        .main-grid {
            display: grid;
            grid-template-columns: 1.1fr 2.3fr 1.1fr 1.1fr;
            gap: 0;
            border: none;
            background: #000;
            min-height: 420px;
        }

        /* Column Styling */
        .column {
            border-right: 2px solid #00ff00;
            min-height: 420px;
        }

            .column:last-child {
                border-right: none;
            }

        /* Plan Produksi Column */
        .plan-column {
            background: #000;
            display: flex;
            flex-direction: column;
            border: 2px solid #00ff00;
        }

        .plan-production {
            padding: 6px 6px 6px 0;
        }

        .plan-header {
            background: #000;
            color: #ff00ff;
            padding: 10px 0 0 0;
            text-align: center;
            font-weight: bold;
            font-size: 30px;
            border: 4px solid #00ff00;
            letter-spacing: 1px;
        }

        .plan-value {
            background: #000;
            color: #fff;
            font-size: 48px;
            font-weight: bold;
            text-align: center;
            padding: 10px;
            border: 4px solid #00ff00;
        }

        .productivity-section {
            background: #000;
            color: #ff00ff;
            padding: 18px 0 20px 0;
            text-align: center;
            font-weight: bold;
            font-size: 22px;
            border: 40px 4px 0 4px solid #00ff00;
        }

        .productivity-value {
            background: #000;
            color: #fff;
            padding: 20px 0 36px 0;
            text-align: center;
            font-size: 22px;
            border-bottom: 2px solid #00ff00;
        }

        .s-pass,
        .polesh-left {
            background: #000;
            color: #ff00ff;
            padding: 25px 0 25px 0;
            text-align: center;
            font-weight: bold;
            font-size: 22px;
            /* border-bottom: solid #00ff00; */
        }

        .polesh-left {
            border-bottom: none;
        }

        /* Checker Column */
        .checker-column {
            background: #000;
            display: flex;
            flex-direction: column;
            border: 4px solid white;
            /* padding: 6px 6px 6px 0; */
        }

        .checker-header {
            background: #000;
            color: #fff;
            /* text-align: center; */
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 40px;
            /* border-bottom: 2px solid #00ff00; */
            /* padding: 10px 0 0 0; */
            margin: 25px 0 25px 0;
            letter-spacing: 2px;
        }

        .checker-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0 auto;
            font-size: 28px;
            font-weight: bold;
            border: 4px solid white;
        }

            .checker-table th,
            .checker-table td {
                border: 2px solid white;
                text-align: center;
                padding: 20px 0;
            }

            .checker-table th {
                background: #000;
                color: #ff00ff;
                font-size: 22px;
                font-weight: bold;
            }

            .checker-table .yellow {
                color: #ffff00;
            }

            .checker-table .green {
                color: #00ff00;
            }

            .checker-table .red {
                color: #ff0000;
            }

            .checker-table .white {
                color: #fff;
            }

        .row-target-achieve {
            padding: 8px 0;
        }

        /* Polesh Column */
        .polesh-column {
            background: #000;
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

        .polesh-header {
            color: #ffff00;
            text-align: center;
            font-weight: bold;
            font-size: 32px;
            border: solid #ffff00;
            padding: 8px 0 0 0;
            letter-spacing: 2px;
        }

        .polesh-ok,
        .polesh-repair {
            background: #000;
            color: #ffff00;
            text-align: center;
            font-weight: bold;
            font-size: 22px;
            /* border-bottom: 2px solid #00ff00; */
            padding: 8px 0 0 0;
        }

        .polesh-repair {
            color: #ff0000;
        }

        .polesh-000,
        .polesh-repair-000 {
            background: #000;
            color: #ffff00;
            text-align: center;
            font-size: 38px;
            font-weight: bold;
            border-bottom: 2px solid white;
            padding: 8px 0 27px 0;
        }

        .polesh-repair-000 {
            color: #ff0000;
            /* animation: blink 1s steps(1) infinite; */
        }

        .polesh-green-000 {
            background: #000;
            color: #00ff00;
            text-align: center;
            font-size: 28px;
            font-weight: bold;
            border: 3px solid white;
            padding: 20px 0;
        }

        /* Right Panel Column */
        .right-panel {
            background: #000;
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

        .temp-header {
            background: #ffff00;
            color: #000;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            /* text-align: center; */
            font-weight: bold;
            font-size: 18px;
            border-top: 2px solid black;
            padding: 20px 0 0 0;
        }

        .date-display {
            background: #ffff00;
            color: #000;
            text-align: right;
            font-size: 14px;
            border-bottom: 2px solid #00ff00;
            padding: 0 6px 8px 0;
            margin-top: -10px;
        }

        .opr-section {
            border: 2px solid #00ff00;
            background: #0066ff;
            padding: 4px 0;
        }

        .opr-header {
            color: #fff;
            text-align: center;
            font-weight: bold;
            font-size: 18px;
            padding: 2px 0 0 0;
        }

        .opr-values {
            display: grid;
            grid-template-columns: 1fr 1fr;
            /* background: #000; */
        }

        .opr-ok {
            /* background: #00ff00; */
            color: white;
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            border-right: 1px solid #222;
            padding: 2px 0;
        }

        .opr-repair {
            /* background: #ff00ff; */
            color: #fff;
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            padding: 2px 0;
        }

        .opr-number {
            /* background: #000; */
            color: #fff;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            padding: 2px 0;
        }

        .opr-box {
            /* border: 2px solid #00ff00; */
            background: #0066ff;
            width: 100%;
            margin-bottom: 8px;
            padding: 8px;
            position: relative;
            font-family: Arial, sans-serif;
        }

        .opr-title {
            position: absolute;
            top: -12px;
            left: 10px;
            background: #0066ff;
            color: white;
            font-weight: bold;
            padding: 0 5px;
        }

        .opr-row {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
        }

        .opr-label {
            font-weight: bold;
            font-size: 14px;
        }

            .opr-label.ok {
                color: #00ff00;
            }

            .opr-label.repair {
                color: #ff00ff;
            }

        .opr-number {
            background: white;
            color: black;
            font-weight: bold;
            font-size: 18px;
            text-align: right;
            width: 140px;
            border: 1px solid #888;
        }

        /* QC */
        .qc-ok {
            background: #00ff00;
            color: #000;
        }

        .qc-pol {
            background: #ffff00;
            color: #000;
        }

        /* Bottom Section */
        .bottom-section {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            border-top: 4px solid #00ff00;
            background: #000;
            min-height: 110px;
        }

        /* .bottom-column {
                border-right: 2px solid #00ff00;
                text-align: center;
              } */

        .bottom-column:last-child {
            border-right: none;
        }

        .bottom-header {
            padding: 4px 0;
            font-weight: bold;
            font-size: 18px;
        }

        .sp-qc-ok {
            background: #00ff00;
            color: #000;
        }

        .pol-qc-ok {
            background: #ffff00;
            color: #000;
        }

        .repair-header {
            background: #ff0000;
            color: #fff;
        }

        .total-header {
            background: #000;
            color: #fff;
        }

        .ok-part-header {
            background: #00ff00;
            color: #000;
        }

        /* .bottom-value-large {
                padding: 8px 0;
                font-size: 38px;
                font-weight: bold;
              } */

        /* .bottom-value-small {
                padding: 2px 0 8px 0;
                font-size: 22px;
                font-weight: bold;
              } */

        .green-text {
            color: #00ff00;
        }

        .yellow-text {
            color: #ffff00;
        }

        .red-text {
            color: #ff0000;
        }

        .white-text {
            color: #fff;
        }

        .target-achieve {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #000;
        }

        .target-cell {
            background: #000;
            color: #fff;
            padding: 4px 0;
            text-align: center;
            font-size: 14px;
            border-right: 1px solid #00ff00;
            border-bottom: 2px solid #00ff00;
        }

            .target-cell:last-child {
                border-right: none;
            }

        .achieve-cell {
            background: #000;
            color: #00ff00;
            padding: 2px 0;
            text-align: center;
            font-size: 18px;
            border-bottom: 2px solid #00ff00;
        }

        .percentage-95 {
            background: #000;
            color: #fff;
            padding: 2px 0;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }

        .percentage-0 {
            background: #000;
            color: #00ff00;
            padding: 2px 0;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }

        .bottom-column {
            position: relative;
            border: 2px solid #fff;
            padding: 15px 10px 10px 10px;
            margin: 10px;
            width: 100%;
        }

        .bottom-header {
            position: absolute;
            top: -12px;
            left: 10px;
            background: black;
            font-weight: bold;
            font-size: 14px;
            padding: 0 5px;
        }

        .sp-qc-ok {
            color: #00ff00;
        }

        .pol-qc-ok {
            color: yellow;
        }

        .total-header {
            color: white;
        }

        .ok-part-header {
            color: cyan;
        }

        .bottom-value-large {
            background: black;
            font-weight: bold;
            font-size: 24px;
            text-align: right;
            margin-top: 10px;
            border: 1px solid #888;
            padding: 5px;
        }

        .bottom-value-small {
            background: black;
            font-weight: bold;
            font-size: 20px;
            text-align: right;
            border: 1px solid #888;
            padding: 5px;
            margin-top: 5px;
        }

        .target-achieve {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            font-weight: bold;
        }

        .target-cell,
        .achieve-cell {
            border: 1px solid #888;
            padding: 5px;
            flex: 1;
            text-align: center;
            margin: 0 2px;
        }

        .percentage-95,
        .percentage-0 {
            font-weight: bold;
            font-size: 20px;
            text-align: right;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header with Date/Time -->
        <div class="header-section">
            <div class="date-time">
                @* @Model.Tanggal.ToString("dddd, dd/MM/yyyy") - @DateTime.Now.ToString("HH:mm:ss") *@
            </div>
        </div>

        <!-- Main Grid Section -->
        <div class="main-grid">
            <!-- PLAN PRODUKSI -->
            <div class="column plan-column">
                <div class="plan-production">
                    <div class="plan-header">PLAN<br />PRODUKSI</div>
                    <div class="plan-value">@Model.ProductionPlan</div>
                </div>
                <div class="productivity-section">PRODUCTIVITY</div>
                <div class="productivity-value">@Model.ProductivityPct %</div>
                <div class="s-pass" style="border: solid #00ff00">S/PASS</div>
                <div class="productivity-value green-text">@Model.StraightPassPct %</div>
                <div class="polesh-left" style="border: solid #00ff00">POLESH %</div>
                <div class="productivity-value yellow-text">@Model.PoleshPct %</div>
            </div>

            <!-- CHECKER TABLE -->
            <div class="column checker-column">
                <div class="checker-header">CHECKER</div>
                <table class="checker-table">
                    <tr>
                        <th>TARGET</th>
                        <th>ACHIEVE</th>
                    </tr>
                    <tr>
                        <td class="white">@Model.TargetCumulativeSaatIni</td>
                        <td class="white">@Model.AchieveCount</td>
                    </tr>
                    <tr>
                        <td class="green">@Model.TargetPerJam</td>
                        <td class="white">@Model.AchievePct %</td>
                    </tr>
                    <tr>
                        <td class="green">@Model.CheckerOkPct %</td>
                        <td style="color:#ff00ff">@Model.CheckerPoleshPct %</td>
                    </tr>
                </table>
            </div>

            <!-- POLESH -->
            <div class="column polesh-column">
                <div class="polesh-header">POLESH</div>
                <div class="polesh-ok">OK</div>
                <div class="polesh-000">
                    <div>@Model.PolesOk</div>
                </div>
                <div class="polesh-repair">REPAIR</div>
                <div class="polesh-repair-000">
                    <div>@Model.PolesNg</div>
                </div>
                <div class="polesh-green-000">@Model.CheckerOk</div>
                <div class="polesh-green-000" style="color: #ffff00">@Model.CheckerPolesh</div>
            </div>

            <!-- RIGHT PANEL -->
            <div class="column right-panel">
                <div class="temp-header">
                    <div style="position:absolute; top:18px; background-color:#ffff00; padding:0px 5px;">TEMP</div>
                    <div>00C</div>
                    <div class="date-display">
                        @* @Model.Tanggal.ToString("dddd, dd/MM/yyyy")<br /> *@
                        @DateTime.Now.ToString("HH:mm:ss")
                    </div>
                </div>

                <!-- contoh operator -->
                <div class="opr-section">
                    <div class="opr-box">
                        <div class="opr-title">OPR1</div>
                        <div class="opr-row">
                            <span class="opr-label ok">OK</span>
                            <div class="opr-number">@Model.CheckerOk</div>
                        </div>
                        <div class="opr-row">
                            <span class="opr-label repair">REPAIR</span>
                            <div class="opr-number">@Model.Repair</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Section -->
        <div class="bottom-section">
            <div class="bottom-column">
                <div class="bottom-header sp-qc-ok">SP QC OK</div>
                <div class="bottom-value-large green-text">@Model.SpQcOk</div>
                <div class="bottom-value-small green-text">@Model.CheckerOkPct %</div>
            </div>

            <div class="bottom-column">
                <div class="bottom-header pol-qc-ok">POL QC OK</div>
                <div class="bottom-value-large yellow-text">@Model.PolQcOk</div>
                <div class="bottom-value-small yellow-text">@Model.CheckerPoleshPct %</div>
            </div>

            <div class="bottom-column">
                <div class="bottom-header red-text">REPAIR</div>
                <div class="bottom-value-large red-text">@Model.Repair</div>
            </div>

            <div class="bottom-column">
                <div class="bottom-header total-header">TOTAL</div>
                <div class="bottom-value-large white-text">@Model.Total</div>
            </div>

            <div class="bottom-column">
                <div class="bottom-header green-text">OK PART</div>
                <div class="target-achieve">
                    <div class="target-cell">TARGET</div>
                    <div class="target-cell">ACHIEVE</div>
                </div>
                <div class="target-achieve">
                    <div class="target-cell">@Model.TargetPerJam</div>
                    <div class="target-cell">@Model.AchieveCount</div>
                </div>
                <div class="target-cell" style="color:#00ff00; text-align:right">
                    @Model.AchievePct %
                </div>
            </div>
        </div>
    </div>

    <script>
        // Real-time clock update
        function updateDateTime() {
          const now = new Date();
          const options = {
            weekday: "long",
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
          };

          const formatter = new Intl.DateTimeFormat("id-ID", options);
          const parts = formatter.formatToParts(now);

          const dayName = parts.find((part) => part.type === "weekday").value;
          const day = parts.find((part) => part.type === "day").value;
          const month = parts.find((part) => part.type === "month").value;
          const year = parts.find((part) => part.type === "year").value;
          const hour = parts.find((part) => part.type === "hour").value;
          const minute = parts.find((part) => part.type === "minute").value;
          const second = parts.find((part) => part.type === "second").value;

          const formattedDateTime = `${dayName}, ${day}/${month}/${year} - ${hour}:${minute}:${second}`;

          // Update both date-time displays
          const dateTimeElements = document.querySelectorAll(
            ".date-time, .date-display"
          );
          dateTimeElements.forEach((element) => {
            if (element.classList.contains("date-display")) {
              element.innerHTML = `${dayName}, ${day}/${month}/${year}<br>${hour}:${minute}:${second}`;
            } else {
              element.textContent = formattedDateTime;
            }
          });
        }

        // Update every second
        setInterval(updateDateTime, 1000);
        updateDateTime(); // Initial update

        // Simulate data updates
        function simulateDataUpdate() {
          // Random updates for demonstration
          const planValue = document.querySelector(".plan-value");
          const currentValue = parseInt(planValue.textContent);
          const newValue = currentValue + Math.floor(Math.random() * 3) - 1; // Random +/- 1
          if (newValue >= 0) {
            planValue.textContent = newValue;
          }
        }

        // Update data every 10 seconds
        setInterval(simulateDataUpdate, 10000);

        // Add blinking effect for critical values
        function addBlinkingEffect() {
          const criticalElements = document.querySelectorAll(
            ".polesh-repair-000, .red-text"
          );
          criticalElements.forEach((element) => {
            setInterval(() => {
              element.style.opacity =
                element.style.opacity === "0.5" ? "1" : "0.5";
            }, 1000);
          });
        }

        // addBlinkingEffect();
    </script>
</body>
</html>
